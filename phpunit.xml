<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         defaultTestSuite="Unit,Feature"
>
    <!-- Browser is declared but kept OUT of the default run by defaultTestSuite
         above: it drives a real Chromium and takes ~22 min against the ~8 of the
         other two, so it stays its own gate (`pest tests/Browser`, which the
         commit hook asks for separately). Declared anyway so the suite names
         what it skips, and so it can be selected by name. -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Testing corre sobre Postgres real, en una base DEDICADA y separada de
             producción. host/puerto/usuario/clave se heredan del .env (mismo
             servidor); aquí solo forzamos la base de testing. NUNCA poner 'atendia'. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="atendia_testing"/>
        <env name="DB_URL" value=""/>
        <!-- Los tests fallan a propósito todo el tiempo: su ruido va a
             testing.log, nunca al laravel.log que lee la pantalla de Logs. -->
        <env name="LOG_CHANNEL" value="testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Browser tests (Pest v4 / Playwright): los browsers se guardan en el volumen
             montado (/var/www/html) para que SOBREVIVAN a recrear el contenedor y sean
             legibles por www-data (el tests corre como ese usuario). Ver .playwright-browsers. -->
        <env name="PLAYWRIGHT_BROWSERS_PATH" value="/var/www/html/.playwright-browsers"/>
        <!-- La suite entera corre en UN proceso: su marca de agua medida es ~240MB
             sobre las 2000+ pruebas, y el escritor de xlsx pide UN bloque de 16MB
             (ZipStream, 0x1000000). Con el 256M del contenedor eso agota la memoria
             justo ahí y la puerta del commit cae por el techo, no por un test. -->
        <ini name="memory_limit" value="512M"/>
    </php>
</phpunit>
